# Lokal: DATABASE_URL weglassen → PGlite-Datei in data/pg
# Vercel/Supabase: Transaction-Pooler URI aus dem Supabase-Dashboard
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
# Produktion: PUBLIC_ORIGIN Pflicht (https://…). Ohne Wert kein iframe-Snippet.
# DATABASE_SSL=insecure
SMTP_HOST=mail.agenturserver.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
DATABASE_URL=
# Login: Supabase Auth. Lokal ohne Keys → PGlite-Seed-Passwörter.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_ADMIN_EMAIL=
# Google Kalender, ein Projekt für alle Salons. Schlüssel nur auf dem Server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ALTCHA im Buchungsfenster. Mindestens 16 Zeichen. Auf Vercel setzen, sonst lehnt die Buchung ab.
ALTCHA_HMAC_KEY=
