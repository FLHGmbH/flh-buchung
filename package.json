{
  "name": "flh-buchung",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --experimental-strip-types server/index.ts",
    "seed": "tsx server/seed.ts",
    "check:slots": "tsx server/slots.check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^1.19.0",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.8",
    "luxon": "^3.7.2",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tsx": "^4.20.5",
    "vite": "^7.1.5"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
